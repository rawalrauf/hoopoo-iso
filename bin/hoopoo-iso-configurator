#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

cleanup() {
  [[ -n "${mock_hoopoo_install:-}" ]] && rm -rf "$(dirname "$mock_hoopoo_install")"
}
trap cleanup EXIT

if [[ -z "${HOOPOO_INSTALL:-}" ]]; then
  if [[ -r /root/hoopoo/install/helpers/all.sh ]]; then
    export HOOPOO_INSTALL=/root/hoopoo/install
  else
    mock_root="$(mktemp -d)"
    mock_hoopoo_install="$mock_root/install"
    mkdir -p "$mock_hoopoo_install/helpers"
    cat >"$mock_hoopoo_install/helpers/all.sh" <<'EOF'
PADDING_LEFT=0
PADDING_LEFT_SPACES=""
clear_logo() { clear; }
EOF
    export HOOPOO_INSTALL="$mock_hoopoo_install"
  fi
fi

exec bash "$repo_root/configs/airootfs/root/configurator" dry "$@"
