#!/bin/bash

if [ $# -eq 0 ]; then
  echo "Usage: hoopoo-iso-upload [release/hoopoo.iso]"
  exit 1
fi

if [[ ! -f ~/.config/rclone/rclone.conf ]]; then
  echo "You must first configure rclone with the R2 credentials: hoopoo-iso-rclone-config"
  exit 1
fi

rclone copy $1 Hoopoo:hoopoo/ -P

if [[ -f $1.sig ]]; then
  rclone copy $1.sig Hoopoo:hoopoo/ -P
fi
